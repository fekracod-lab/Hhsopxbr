<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>مدار</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mudar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	
	<!-- App Transport Security - Required for Google Maps iOS SDK tile loading -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	
	<!-- Camera & Microphone usage descriptions -->
	<key>NSCameraUsageDescription</key>
	<string>التطبيق يحتاج الوصول الى الكاميرا لالتقاط صور الوجبات أو الملف الشخصي</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>التطبيق يحتاج الوصول إلى الميكروفون عند التواصل الصوتي مع الدعم الفني أو استخدام المساعد الصوتي</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>التطبيق يحتاج الوصول إلى خدمة التعرف على الصوت لتحويل صوتك إلى أوامر نصية</string>
	
	<!-- Photo Library usage -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>التطبيق يحتاج الوصول إلى مكتبة الصور لاختيار صور الوجبات أو الملف الشخصي</string>

	<!-- Location usage -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>نحتاج لموقعك لتحديد عنوان التوصيل بدقة وحساب المسافة للمطاعم</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>نحتاج لموقعك لتتبع مكان السائق والطلبات بدقة حتى في الخلفية</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>نحتاج لموقعك لتتبع مكان السائق والطلبات بدقة في الخلفية</string>

	<!-- URL Launching schemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>https</string>
		<string>mailto</string>
		<string>googlemaps</string>
		<string>comgooglemaps</string>
	</array>

	<!-- Google Sign-In URL Types -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Google Sign-In URL scheme -->
				<string>com.googleusercontent.apps.656705978860-uuk2dosi4tjrc1q1geip905377grs52q</string>
			</array>
		</dict>
	</array>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Required for Flutter platform views (e.g. Google Maps) on iOS -->
	<key>io.flutter.embedded_views_preview</key>
	<true/>

	<!-- Push Notifications Support -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
</dict>
</plist>
